FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Path ke model (relatif dari folder backend/)
MODEL_PATH=../ml-model/model/plant_disease_model.h5
LABELS_PATH=../ml-model/model/class_labels.json

# CORS: URL frontend Next.js
FRONTEND_URL=http://localhost:3000

# Upload config
MAX_FILE_SIZE_MB=10

# PostgreSQL Database (via Docker)
# Sesuaikan dengan kredensial di docker-compose.yml
DATABASE_URL=postgresql://plantscan_user:plantscan_pass@localhost:5432/plantscan_db
